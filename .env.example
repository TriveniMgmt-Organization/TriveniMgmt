# TriveniMgmt Backend - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE (Required)
# ===========================================
DB_HOST=jdbc:postgresql://localhost:5432/store_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=20

# ===========================================
# JWT AUTHENTICATION (Required)
# ===========================================
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-256-bit-secret-key-here-minimum-32-characters
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=http://localhost:8080

# ===========================================
# SERVER (Optional)
# ===========================================
SERVER_PORT=8080

# ===========================================
# CORS (Required)
# ===========================================
FRONTEND_URL=http://localhost:3000

# ===========================================
# SPRING PROFILE (Optional)
# ===========================================
# dev = creates demo users, enables detailed logging
# prod = production mode, no demo users
SPRING_PROFILES_ACTIVE=dev

# ===========================================
# EMAIL (Optional - for invitations)
# ===========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
